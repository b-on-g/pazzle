	Link_http* $mol_link_iconed
		uri <= link_uri* \
		content / <= link_host* \
	Embed* $mol_embed_any
		uri <= link_uri* \
		title <= line_text* \
	- \Spoilers
	Spoiler* $mol_expander
		label /
			<= Spoiler_label* $mol_text
				text <= spoiler_label* \
		content /
			<= Spoiler_content* $mol_text
				text <= spoiler_content* \

$mol_text_header $mol_paragraph
	level 1
	sub /
		<= Link $mol_link
			arg <= arg *
			hint @ \Permalink to this section
			sub <= content /

$mol_text_span $mol_paragraph
	dom_name \span
	attr *
		^
		mol_text_type <= type \

$mol_row $mol_view

$bog_pazzle_board_victory $mol_view
	moves 0
	time \
	best \
	again? null
	home? null
	saves? null
	sub /
		<= Card $mol_list
			rows <= card_content /
				<= Title $mol_text
					text \Пазл собран!
				<= Stats $mol_text
					text <= stats \
				<= Best $mol_text
					text <= best
				<= Actions $mol_row
					sub /
						<= Again $mol_button_major
							title \Ещё раз
							click? <=> again?
						<= Home $mol_button_minor
							title \Другая картинка
							click? <=> home?
						<= Saves $mol_button_minor
							title \Мои пазлы
							click? <=> saves?

$rise_drag $mol_plugin
	x? 0
	y? 0
	repos_x* 1
	repos_y* 1
	-
	on_drag? null
	on_drag_start? null
	on_drag_end? null
	-
	drag? null
	drag_start? null
	drag_end? null
	-
	use_buttons /
		0 - \left
		-\ 1 - \right
		-\ 2 - \middle
	-
	event *
		^
		pointerdown? <=> pointerdown? null
	attr *
		^
		rise_dragged <= dragged? false
	-
	auto /
		<= pointermove_listener null $mol_dom_listener
		<= pointerup_listener null $mol_dom_listener
	-
	drags_synced /$rise_drag

$rise_drag_view $mol_view
	plugins /
		^
		<= Drag $rise_drag
			on_drag_start? <=> on_drag_start? null
			on_drag_end? <=> on_drag_end? null
			on_drag? <=> on_drag? null
			dragged => dragged
			y? <=> y? 0
			x? <=> x? 0
			drags_synced <= drags_synced /$rise_drag
			repos_x* <= repos_x* 1
			repos_y* <= repos_y* 1
			pointerdown? => pointerdown?
	style *
		^
		userSelect \none

$bog_pazzle_board_tile $rise_drag_view
	rows 1
	columns 1
	piece 0
	slot 0
	image_uri \
	playable false
	locked false
	selected false
	label \
	sub /
		<= Number $mol_text
			text <= label

$mol_text_list $mol_text
	auto_scroll null
	attr *
		^
		mol_text_list_type <= type \
	Paragraph* $mol_text_list_item
		index <= item_index*
		sub <= block_content*

$mol_text_list_item $mol_paragraph
	attr *
		^
		mol_text_list_item_index <= index 0

$bog_pazzle_board $mol_view
	image_uri \
	rows 1
	columns 1
	numbers false
	playable false
	peek false
	order /number
	moves 0
	time \
	best \
	apply? null
	again? null
	home? null
	saves? null
	sub <= board_content /
		<= Placeholder $mol_text
			text \Выберите картинку — здесь появится предпросмотр.
		<= Field $mol_view
			style *
				maxWidth <= field_width \
			sub <= field_content /
				<= Grid $mol_view
					style *
						gridTemplateColumns <= grid_columns \
						gridTemplateRows <= grid_rows \
						aspectRatio <= grid_ratio \
					attr *
						bog_pazzle_assembled <= merged false
					sub <= tiles /
				<= Peek $mol_image
					uri <= image_uri
					title \Оригинал
				<= Victory $bog_pazzle_board_victory
					moves <= moves
					time <= time
					best <= best
					again? <=> again?
					home? <=> home?
					saves? <=> saves?
	Tile* $bog_pazzle_board_tile
		rows <= rows
		columns <= columns
		image_uri <= image_uri
		playable <= playable
		locked <= tile_locked* false
		piece <= tile_piece* 0
		slot <= tile_slot* 0
		label <= tile_label* \
		selected <= tile_selected* false
		drags_synced <= tile_synced* /
		on_drag_start? <=> tile_press*? null
		on_drag? <=> tile_drag*? null
		on_drag_end? <=> tile_drop*? null

$mol_labeler $mol_list
	rows /
		<= Label $mol_view
			minimal_height 32
			sub <= label /$mol_view_content
				<= title
		<= Content $mol_view
			minimal_height 24
			sub <= content /

$mol_icon_upload $mol_icon path \M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z

$mol_button_open $mol_button_minor
	sub /
		<= Icon $mol_icon_upload
		<= Native $mol_button_open_native
			files? <=> files_handled? <=> files? /File
			accept <= accept \
			multiple <= multiple true

$mol_button_open_native $mol_view
	dom_name \input
	files? /File
	attr *
		type \file
		accept <= accept \
		multiple <= multiple true
	event *
		change? <=> picked? null

$bog_pazzle_upload_image $mol_button_open
	hint \Выбрать картинку
	image_uri \
	picked? null
	accept \image/*
	multiple false
	sub /
		<= Icon $mol_icon_image_plus
		<= Preview $mol_image
			uri <= image_uri
			title \Выбранная картинка
		<= Native

$mol_icon_chevron_left $mol_icon path \M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z

$mol_icon_chevron_right $mol_icon path \M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z

$mol_number $mol_view
	precision_view <= precision 1
	precision_change <= precision 1
	boost 10
	value_min -Infinity
	value_max +Infinity
	value? +NaN
	enabled true
	plugins /
		<= Hotkey $mol_hotkey
			key *
				down? <=> event_dec? null
				up? <=> event_inc? null
				pageDown? <=> event_dec_boost? null
				pageUp? <=> event_inc_boost? null
	sub /
		<= Dec $mol_button_minor
			event_click? <=> event_dec? null
			enabled <= dec_enabled <= enabled
			sub / <= dec_icon $mol_icon_chevron_left
		<= String $mol_string
			- \ we don't want native number controls in mobile devices
			- \ https://stackoverflow.com/questions/3790935/can-i-hide-the-html5-number-input-s-spin-box
			type <= type \text
			keyboard \decimal
			value? <=> value_string? \
			hint <= hint \ 
			enabled <= string_enabled <= enabled
			submit? <=> submit? null
		<= Inc $mol_button_minor
			event_click? <=> event_inc? null
			enabled <= inc_enabled <= enabled
			sub / <= inc_icon $mol_icon_chevron_right

$mol_icon_tick $mol_icon path \M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z

$mol_check_box $mol_check
	Icon $mol_icon_tick

$bog_pazzle_settings $mol_list
	grid_rows? 4
	grid_columns? 4
	numbers? true
	Preset* $mol_button_minor
		title <= preset_title* \
		click? <=> preset_pick*? null
		attr *
			^
			bog_pazzle_current <= preset_current* false
	rows /
		<= Size $mol_labeler
			title \Размер сетки
			content /
				<= Size_row $mol_view
					sub /
						<= Rows_input $mol_number
							value_min 2
							value_max 12
							value? <=> grid_rows?
							hint \строк
						<= Times $mol_text
							text \×
						<= Columns_input $mol_number
							value_min 2
							value_max 12
							value? <=> grid_columns?
							hint \столбцов
		<= Presets $mol_view
			sub <= presets /
		<= Numbers $mol_check_box
			title \Показывать номера фрагментов
			checked? <=> numbers?

$bog_pazzle_upload $mol_list
	image_uri \
	picked? null
	grid_rows? 4
