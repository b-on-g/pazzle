		<= Game

$mol_icon_delete $mol_icon path \M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z

$bog_pazzle_saves_item $mol_view
	id \
	open? null
	drop? null
	sub /
		<= Open $mol_button_minor
			hint \Открыть пазл
			click? <=> open_click? null
			sub /
				<= Thumb $mol_image
					uri <= thumb \
					title \
				<= Info $mol_list
					rows /
						<= Label $mol_text
							text <= label \
						<= Stat $mol_text
							text <= stat \
		<= Drop $mol_button_minor
			hint <= drop_hint \
			click? <=> drop_click? null
			attr *
				^
				bog_pazzle_confirm <= confirm? false
			sub /
				<= Drop_icon $mol_icon_delete

$bog_pazzle_saves $mol_list
	open? null
	create? null
	Row* $bog_pazzle_saves_item
		id <= row_id* \
		open? <=> open?
		drop? <=> drop? null
	rows <= saves_content /
		<= Empty $mol_text
			text \Здесь пока пусто. Загрузите картинку — и пазл появится в списке.
		<= Create $mol_button_major
			hint \Собрать пазл из другой картинки
			click? <=> create?
			sub /
				<= Create_icon $mol_icon_image_plus
				\Новый пазл

$bog_pazzle_help $mol_list
	rows /
		<= Rules $mol_text
			text \
				\## Как играть
				\
				\1. Загрузите картинку — подойдёт любое фото с телефона.
				\2. Выберите размер сетки: чем больше клеток, тем дольше собирать.
				\3. Нажмите «Начать игру».
				\
				\## Как двигать фрагменты
				\
				\- **Перетащите** фрагмент на место другого — они поменяются местами.
				\- Или **нажмите** на один фрагмент, потом на другой — тот же обмен, удобно на телефоне.
				\- Соседние фрагменты, вставшие рядом правильно, **слипаются** и дальше едут вместе.
				\- Фрагмент, попавший на своё место, **закрепляется** и больше не двигается.
				\
				\## Подсказки
				\
				\- Кнопка «Оригинал» показывает картинку целиком поверх доски.
				\- «Заново» перемешивает ту же картинку и обнуляет счёт.
				\- Номера фрагментов можно выключить в настройках — так сложнее.
				\
				\## Что сохраняется
				\
				\Партия сама записывается в браузер после каждого хода: можно закрыть
				\вкладку и вернуться позже. Список начатых пазлов лежит в «Моих пазлах».

$bog_pazzle $mol_page
	plugins /
		<= Theme $bog_theme_auto
	title <= caption \
	tools /
		<= Theme_toggle $bog_theme_toggle
			theme_auto <= Theme
	body <= screen /
	Back $mol_button_minor
		hint \В меню
		click? <=> go_home?
		sub /
			<= Back_icon $mol_icon_arrow_left
	-
	go_home? null
	go_play? null
	go_saves? null
	go_help? null
	start? null
	again? null
	move? null
	open? null
	peek? false
	-
	Home $bog_pazzle_layout
		Menu <= Menu $bog_pazzle_menu
			resumable <= resumable false
			saves_count <= saves_count 0
			home? <=> go_home?
			play? <=> go_play?
			saves? <=> go_saves?
			help? <=> go_help?
		Upload <= Upload $bog_pazzle_upload
			image_uri <= draft_image \
			picked? <=> draft_picked? null
			grid_rows? <=> draft_rows? 4
			grid_columns? <=> draft_columns? 4
			numbers? <=> draft_numbers? true
			start? <=> start?
			Preview <= Preview $bog_pazzle_board
				image_uri <= draft_image
				rows <= draft_rows
				columns <= draft_columns
				numbers <= draft_numbers
				order <= draft_order /number
	-
	Play $bog_pazzle_play
		moves <= moves 0
		time <= time \
		peek? <=> peek?
		again? <=> again?
		Game <= Game $bog_pazzle_board
			playable true
			image_uri <= image \
			rows <= rows 1
			columns <= columns 1
			numbers <= numbers false
			order <= order /number
			moves <= moves
			time <= time
			best <= best \
			peek <= peek?
			apply? <=> move?
			again? <=> again?
			home? <=> go_home?
			saves? <=> go_saves?
	-
	Saves $bog_pazzle_saves
		open? <=> open?
		create? <=> go_home?
	-
	Help $bog_pazzle_help
